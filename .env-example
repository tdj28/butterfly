# Copy this file to .env and fill in only the credentials needed for your
# workflow. Never commit .env or real credential values.

# Required only for scripts/runpodctl.py and RunPod GPU workflows.
RUNPOD_API_KEY=

# Optional placeholders for external AI/research workflows; the repository
# does not currently consume these four credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
OSF_TOKEN=

# Optional, non-secret GPU selection override recorded in compute receipts.
# CUDA_VISIBLE_DEVICES=0
